#!/usr/bin/env bash
# PostToolUse hook 模板：Claude 改完 UI 文件后自动跑 headless 校验。
# 用法：复制到 .claude/hooks/ui_bounds_check.sh，替换 {{GODOT_PATH}} / {{PROJECT_PATH}} / {{UI_PATH_PATTERNS}}。

set -u

payload="$(cat)"

file_path="$(printf '%s' "$payload" | python -c "
import json, sys
try:
    d = json.load(sys.stdin)
    print(d.get('tool_input', {}).get('file_path', '') or d.get('tool_input', {}).get('path', ''))
except Exception:
    pass
" 2>/dev/null)"

if [ -z "$file_path" ]; then
    exit 0
fi

# UI 文件路径匹配（按项目调整）
case "$file_path" in
    {{UI_PATH_PATTERNS}})
        ;;
    *)
        exit 0
        ;;
esac

GODOT="{{GODOT_PATH}}"
PROJECT="{{PROJECT_PATH}}"

output="$("$GODOT" --path "$PROJECT" --headless --script res://addons/ui_safety/runtime/run_bounds_check_cli.gd 2>&1)"
exit_code=$?

if [ $exit_code -eq 0 ]; then
    exit 0
elif [ $exit_code -eq 2 ]; then
    echo "[ui_bounds_check] WARN: validator failed to load, skipping" >&2
    echo "$output" | tail -5 >&2
    exit 0
else
    echo "[ui_bounds_check] FAIL: UI bounds issues detected after editing $file_path" >&2
    echo "$output" | grep -E '^\s*\[(OUT_OF_BOUNDS|OVERLAP|SIZE_TOO_SMALL)\]|^===' >&2
    echo "" >&2
    echo "[ui_bounds_check] Please fix the above issues or add them to the whitelist if intentional." >&2
    exit 2
fi
